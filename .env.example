# Gemini Code — Environment Configuration
# Copy this file to .env and fill in GEMINI_API_KEY to get started immediately.
# Everything else is optional: by default Gemini Code runs locally in single-user mode.

# --- Core AI (Google Gemini) -------------------------------------------------
GEMINI_API_KEY=
# DEFAULT_MODEL=gemini-2.5-flash
# RISK_MODEL=gemini-2.5-flash

# --- Local Runtime (default) -------------------------------------------------
# PORT=8787
# WORKSPACE_DIR=./workspace
# DATA_DIR=./packages/server/data
# ENCRYPTION_KEY= # auto-generated in DATA_DIR/.encryption-key if omitted

# --- Optional: Secondary AI Providers ----------------------------------------
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# --- Optional: Cloud Computers (Fly Sprites) ---------------------------------
# Set SPRITES_TOKEN to run isolated Ubuntu + Chrome cloud machines per agent.
# COMPUTER_MODE=local # 'local' or 'sprites'
# SPRITES_TOKEN=
# SPRITES_ORG=
# SPARE_COMPUTERS=0

# --- Optional: External Auth (JWKS) ------------------------------------------
# Leave empty for zero-login local mode.
# AUTH_MODE=local # 'local' or 'jwt'
# AUTH_API_URL=
# AUTH_ISSUER=gemini-code-auth
# OWNER_EMAIL=
# ACCESS_MODE=open

# --- Optional: GitHub Workspace Sync -----------------------------------------
# GITHUB_ORG=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Optional: Voice & Notifications -----------------------------------------
# FISH_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WAKE_URL=
# WAKE_SECRET=
# MCP_CATALOG_URL=
